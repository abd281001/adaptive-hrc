#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
NORMAL_PYTHON="$PROJECT_ROOT/venv/bin/python"
LLM_PYTHON="$PROJECT_ROOT/.venv-llm/bin/python"
COOKING_PYTHON="$PROJECT_ROOT/burrito/.venv/bin/python"
COOKING_CONFIG="$PROJECT_ROOT/burrito/configs/full.json"

usage() {
    cat <<'EOF'
Usage: ./hrc COMMAND [ARGS]

Commands:
  setup       Create venv for HRC.ipynb, normal experiments, and tests
  setup-llm   Create .venv-llm for the GPU LLM baseline
  kernel      Register venv as the HRC Jupyter kernel
  test        Run the test suite
  test-cooking Run the pinned-Burrito test suite in burrito/.venv
  run         Run the full normal evaluation
  cooking     Run and validate the full Overcooked/Burrito evaluation
  ablation    Run ablations into the standard run; pass --groups all or a
              comma list of matcher|components|retention|latent|memory|
              representation|routing (default: all)
  robot-ui    Run the real-robot operator UI (dry-run unless --hardware-url is set)
  robot-bridge Run the local Stretch hardware bridge (motion off unless --enable-motion)
  robot-doctor Check robot config/runtime/bridge without commanding motion
  robot-report Summarize and integrity-check a completed robot run
  robot-calibration-probe Run one explicitly confirmed calibration-mode action
  llm [scope] Run full-schedule one-seed Full + LLM; scope: all|homogeneous|heterogeneous|holdout
              Re-run the same command after a crash to continue where it stopped
  doctor      Check the normal and LLM runtimes without starting an experiment
EOF
}

ensure_normal_python() {
    if [[ ! -x "$NORMAL_PYTHON" ]]; then
        echo "Missing $NORMAL_PYTHON. Run ./hrc setup first." >&2
        exit 1
    fi
}

ensure_llm_python() {
    if [[ ! -x "$LLM_PYTHON" ]]; then
        echo "Missing $LLM_PYTHON. Run ./hrc setup-llm first." >&2
        exit 1
    fi
}

ensure_cooking_python() {
    if [[ ! -x "$COOKING_PYTHON" ]]; then
        echo "Missing $COOKING_PYTHON. Run ./burrito/bootstrap.sh first." >&2
        exit 1
    fi
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

cd "$PROJECT_ROOT"

case "$command" in
    setup)
        if [[ ! -x "$NORMAL_PYTHON" ]]; then
            "${HRC_BOOTSTRAP_PYTHON:-python3.13}" -m venv venv
        fi
        "$NORMAL_PYTHON" -m pip install -r requirements.txt
        ;;
    setup-llm)
        if [[ ! -x "$LLM_PYTHON" ]]; then
            "${HRC_LLM_BOOTSTRAP_PYTHON:-/usr/bin/python3.12}" -m venv .venv-llm
        fi
        "$LLM_PYTHON" -m pip install -r requirements-llm.txt
        ;;
    kernel)
        ensure_normal_python
        "$NORMAL_PYTHON" -m ipykernel install --user \
            --name adaptive-hrc \
            --display-name "Python (adaptive-hrc)"
        ;;
    test)
        ensure_normal_python
        exec "$NORMAL_PYTHON" -m pytest "$@"
        ;;
    test-cooking)
        # These need the pinned simulator, so they cannot run under the normal
        # venv alongside ./hrc test -- which is why nothing ran them and two
        # defects reached a full evaluation. burrito/.venv has no pytest.
        ensure_cooking_python
        exec env PYTHONPATH="$PROJECT_ROOT/burrito/wrapper" \
            "$COOKING_PYTHON" -m unittest discover \
            -s "$PROJECT_ROOT/burrito/tests" \
            "$@"
        ;;
    run)
        ensure_normal_python
        run_args=()
        if [[ -n "${HRC_WORKERS:-}" ]]; then
            run_args+=(--workers "$HRC_WORKERS")
        fi
        exec "$NORMAL_PYTHON" -X faulthandler -m src.evaluation \
            "${run_args[@]}" \
            "$@"
        ;;
    cooking)
        ensure_cooking_python
        cooking_args=()
        if [[ -n "${HRC_COOKING_RESUME:-}" ]]; then
            cooking_args+=(--resume "$HRC_COOKING_RESUME")
        fi
        if [[ -n "${HRC_COOKING_WORKERS:-}" ]]; then
            cooking_args+=(--workers "$HRC_COOKING_WORKERS")
        fi
        exec "$COOKING_PYTHON" -X faulthandler \
            -m adaptive_hrc_burrito validate \
            --config "$COOKING_CONFIG" \
            "${cooking_args[@]}" \
            "$@"
        ;;
    ablation)
        ensure_normal_python
        exec "$NORMAL_PYTHON" -X faulthandler -m src.ablations \
            --workers "${HRC_ABLATION_WORKERS:-8}" \
            "$@"
        ;;
    robot-ui)
        ensure_normal_python
        exec "$NORMAL_PYTHON" -X faulthandler -m src.real_robot.app "$@"
        ;;
    robot-bridge)
        # The live bridge must use the Stretch SDK environment on the robot.
        # Override HRC_STRETCH_PYTHON there; venv is suitable for bridge dry-runs.
        STRETCH_PYTHON="${HRC_STRETCH_PYTHON:-$NORMAL_PYTHON}"
        if [[ ! -x "$STRETCH_PYTHON" ]]; then
            echo "Missing Stretch Python: $STRETCH_PYTHON" >&2
            exit 1
        fi
        exec "$STRETCH_PYTHON" -X faulthandler -m src.real_robot.bridge "$@"
        ;;
    robot-doctor)
        DOCTOR_PYTHON="${HRC_STRETCH_PYTHON:-$NORMAL_PYTHON}"
        if [[ ! -x "$DOCTOR_PYTHON" ]]; then
            echo "Missing robot Python: $DOCTOR_PYTHON" >&2
            exit 1
        fi
        exec "$DOCTOR_PYTHON" -X faulthandler -m src.real_robot.doctor "$@"
        ;;
    robot-report)
        ensure_normal_python
        exec "$NORMAL_PYTHON" -X faulthandler -m src.real_robot.report "$@"
        ;;
    robot-calibration-probe)
        ensure_normal_python
        exec "$NORMAL_PYTHON" -X faulthandler -m src.real_robot.calibration_probe "$@"
        ;;
    llm)
        ensure_llm_python
        llm_scenario_args=()
        case "${1:-}" in
            homogeneous|homo)
                shift
                llm_scenario_args=(--scenarios homogeneous)
                ;;
            heterogeneous|hetero)
                shift
                llm_scenario_args=(--scenarios heterogeneous)
                ;;
            holdout|axis|axis-holdout)
                shift
                llm_scenario_args=(--scenarios holdout)
                ;;
            all)
                shift
                ;;
        esac
        export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
        export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
        export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
        export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
        export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
        exec "$LLM_PYTHON" -X faulthandler -m src.llm_baseline \
            --workers 1 \
            --threads 1 \
            --output eval_results/llm_runs \
            "${llm_scenario_args[@]}" \
            "$@"
        ;;
    doctor)
        ensure_normal_python
        ensure_llm_python
        "$NORMAL_PYTHON" -c 'import matplotlib, numpy, pytest; print("normal runtime: OK")'
        "$LLM_PYTHON" -c 'from src.llm_baseline import preflight_llm_runtime; print("LLM runtime:", preflight_llm_runtime())'
        # The prompt grows with replay memory, so a card shared with a desktop
        # can run for hours and then stop. Report the budget before that.
        "$LLM_PYTHON" - <<'PY'
from src.llm_baseline import report_vram_budget
b = report_vram_budget()
print(
    "LLM VRAM budget: "
    f"total={b['total_gib']:.2f}GiB "
    f"other_clients={b['other_clients_gib']:.2f}GiB "
    f"display_reserve={b['headroom_gib']:.2f}GiB "
    f"weights={b['weights_gib']:.2f}GiB "
    f"-> ~{b['prompt_token_estimate']} prompt tokens "
    f"(~{b['prompt_token_estimate_if_gpu_exclusive']} with this GPU to itself)"
)
PY
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
